# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# IDEs y editores
.vscode/
*.swp
*.swo
*~

# Archivos temporales
*.tmp
*.temp
*.cache

# Archivos de configuración local
.env
.env.local
.env.*.local

# Carpetas de respaldo
backup/
*.backup

# Archivos de compilación generales
*.o
*.so
*.dylib
*.dll

# Archivos de documentación generados
*.pdf
*.doc
*.docx
docs/generated/

# React Native
parking-management-mobile/node_modules/
parking-management-mobile/npm-debug.log
parking-management-mobile/yarn-error.log

# iOS
parking-management-mobile/ios/Pods/
parking-management-mobile/ios/build/
parking-management-mobile/ios/*.xcworkspace
!parking-management-mobile/ios/*.xcworkspace/contents.xcworkspacedata

# Android
parking-management-mobile/android/build/
parking-management-mobile/android/app/build/
parking-management-mobile/android/.gradle/
parking-management-mobile/android/local.properties

# Environment
parking-management-mobile/.env
parking-management-mobile/.env.local
parking-management-mobile/.env.*.local

# IDE
parking-management-mobile/.vscode/
parking-management-mobile/.idea/

# macOS
parking-management-mobile/.DS_Store

# Test
parking-management-mobile/coverage/

# Misc
parking-management-mobile/.bundle
