									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"username\": \"pepe\",\n    \"password\": \"1234\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/auth/login",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"auth",
										"login"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJwZXBlIiwiaWF0IjoxNzAzMDA3NjAwLCJleHAiOjE3MDMwOTQwMDB9.example\",\n    \"type\": \"Bearer\",\n    \"username\": \"pepe\",\n    \"message\": \"Login exitoso\"\n}"
