						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{recoveryToken}}\"\n}"
						},
						"url": "{{baseUrl}}/auth/password-recovery/verify",
						"description": "Verify if a recovery token is valid"
					},
					"response": []
				},
				{
					"name": "Reset Password",
