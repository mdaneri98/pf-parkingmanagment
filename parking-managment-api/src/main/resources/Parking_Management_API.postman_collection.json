{
  "info": {
    "_postman_id": "parking-management-api",
    "name": "Parking Management API",
    "description": "Colección de endpoints de Autenticación y Usuarios para validar cambios.\n\nInstrucciones rápidas:\n1) Ejecuta Auth > Register (opcional)\n2) Ejecuta Auth > Login\n3) La colección guardará automáticamente accessToken y refreshToken\n4) Ejecuta Auth > Refresh / Logout y los endpoints de Usuarios\n\nVariables requeridas (entorno):\n- baseUrl: http://localhost:8081/api\n- accessToken: se setea en Login/Refresh\n- refreshToken: se setea en Login/Refresh",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) {",
          "  console.warn('baseUrl no configurado. Ej: http://localhost:8081/api');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log('Status:', pm.response.code, pm.response.status);",
          "console.log('Response time:', pm.response.responseTime + 'ms');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Autentica y devuelve ApiResponse<LoginResponse>. Guarda accessToken y refreshToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "pm.test('ApiResponse.success true', function () { pm.expect(res.success).to.eql(true); });",
                  "pm.test('Tiene data.token', function () { pm.expect(res.data && res.data.token).to.be.a('string'); });",
                  "pm.environment.set('accessToken', res.data.token);",
                  "if (res.data && res.data.refreshToken) { pm.environment.set('refreshToken', res.data.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (user)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"securePassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Crea usuario común. Devuelve ApiResponse<RegisterResponse>."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register 201', function () { pm.response.to.have.status(201); });",
                  "const res = pm.response.json();",
                  "pm.test('ApiResponse.success true', function () { pm.expect(res.success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (manager)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Manager\",\n  \"email\": \"jane.manager@example.com\",\n  \"password\": \"securePassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register?manager=true", "host": ["{{baseUrl}}"], "path": ["auth", "register"], "query": [ { "key": "manager", "value": "true" } ] },
            "description": "Crea usuario con rol manager (via entidad Manager)."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Register manager 201', function () { pm.response.to.have.status(201); });"
            ] } }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Rotación de refresh token. Devuelve ApiResponse<RefreshTokenResponse>. Actualiza accessToken/refreshToken."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Refresh 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "pm.environment.set('accessToken', res.data.token);",
              "pm.environment.set('refreshToken', res.data.refreshToken);"
            ] } }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Revoca el refresh token (logout)."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Logout 200', function () { pm.response.to.have.status(200); });",
              "pm.environment.unset('accessToken');",
              "pm.environment.unset('refreshToken');"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{accessToken}}", "type": "string" } ] },
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "Lista usuarios."
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carlos\",\n  \"lastName\": \"Rodríguez\",\n  \"email\": \"carlos.rodriguez@example.com\",\n  \"password\": \"password123\",\n  \"imageUrl\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "Crea usuario. Requiere rol MANAGER o ADMIN (según SecurityConfig)."
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('201', function(){ pm.response.to.have.status(201); });" ] } } ]
        },
        {
          "name": "Get user by id",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/1", "host": ["{{baseUrl}}"], "path": ["users", "1"] } },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ]
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"NuevoNombre\",\n  \"lastName\": \"NuevoApellido\",\n  \"imageUrl\": \"https://example.com/new.jpg\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/1", "host": ["{{baseUrl}}"], "path": ["users", "1"] },
            "description": "Actualiza usuario. Requiere rol MANAGER o ADMIN."
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ]
        },
        {
          "name": "Delete user",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/users/1", "host": ["{{baseUrl}}"], "path": ["users", "1"] } },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('204', function(){ pm.response.to.have.status(204); });" ] } } ]
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/search?q=juan", "host": ["{{baseUrl}}"], "path": ["users", "search"], "query": [ { "key": "q", "value": "juan" } ] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ]
        }
      ],
      "description": "Endpoints de usuarios (requieren Authorization: Bearer {{accessToken}}). Para POST/PUT/DELETE se requiere MANAGER o ADMIN."
    }
  ]
}