						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.environment.set('accessToken', '');",
									"    pm.environment.set('refreshToken', '');",
									"    console.log('Logout successful - tokens cleared');",
									"}"
								],
