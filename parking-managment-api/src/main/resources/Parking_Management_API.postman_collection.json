							"raw": "{\n    \"email\": \"{{recoveryEmail}}\"\n}"
						},
						"url": "{{baseUrl}}/auth/password-recovery/request",
						"description": "Request password recovery for an email address"
					},
					"response": []
				},
				{
					"name": "Verify Recovery Token",
					"request": {
						"method": "POST",
						"header": [
