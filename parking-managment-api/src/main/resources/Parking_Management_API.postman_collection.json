							"raw": "{\n    \"name\": \"{{parkingLotName}}\",\n    \"address\": \"{{parkingLotAddress}}\",\n    \"imageUrl\": \"{{parkingLotImageUrl}}\",\n    \"managerId\": {{managerId}},\n    \"spots\": [\n        {\n            \"vehicleType\": \"{{spotVehicleType}}\",\n            \"floor\": {{spotFloor}},\n            \"code\": \"{{spotCode}}\",\n            \"isAvailable\": {{spotIsAvailable}}\n        }\n    ]\n}"
